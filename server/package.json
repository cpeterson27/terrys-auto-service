{
  "name": "terry-auto-service-server",
  "version": "1.0.0",
  "description": "Express backend for Terry's auto service platform",
  "main": "dist/app.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "seed:admin": "ts-node --files src/scripts/seedAdmin.ts",
    "check:cloudinary": "ts-node --files src/scripts/checkCloudinary.ts",
    "smoke:api": "ts-node --files src/scripts/smokeApi.ts",
    "test:schemas": "ts-node --files src/scripts/testSchemas.ts",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "axios": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.5.0",
    "multer": "^2.1.1",
    "resend": "^1.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/jsonwebtoken": "^9.0.4",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.8.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  }
}
